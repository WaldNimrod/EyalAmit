    {
      "@type": "FAQPage",
      "@id": "http://eyalamit-co-il-2026.s887.upress.link/#/schema/faqpage/vekatavta",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "האם הספר מתאים גם לקריאה קצרה?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<p>כן. בגלל המבנה שלו, הוא מתאים מאוד לקריאה בטיסות, חופשות או בין רגעים במהלך היום.</p>"
          }
        },
        {
          "@type": "Question",
          "name": "האם כל הסיפורים אמיתיים?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<p>כן. כל הסיפורים מבוססים על אירועים אמיתיים מחייו של אייל.</p>"
          }
        },
        {
          "@type": "Question",
          "name": "האם צריך לקרוא את הספר ברצף?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<p>לא. הספר בנוי מסיפורים קצרים, וכל סיפור עומד בפני עצמו. אפשר לפתוח בכל עמוד.</p>"
          }
        },
        {
          "@type": "Question",
          "name": "יש גם תוכן נוסף מעבר לספר?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<p>כן. בסיום כל סיפור יש קוד QR שמוביל להמשך, וידאו או תוכן נוסף.</p>"
          }
        },
        {
          "@type": "Question",
          "name": "כמה סיפורים יש בספר?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<p>46 סיפורים קצרים.</p>"
          }
        },
        {
          "@type": "Question",
          "name": "כמה עמודים יש בספר?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<p>252 עמודים.</p>"
          }
        },
        {
          "@type": "Question",
          "name": "מה זה ספוקן סטוריז?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<p>זה סגנון כתיבה שבו הסיפור מרגיש כאילו הוא מסופר בעל פה. הקריאה זורמת, ישירה ואישית.</p>"
          }
        }
      ]
